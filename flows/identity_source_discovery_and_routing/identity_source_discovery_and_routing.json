            "input": {
                "inputData": "statements:\n- context: ids_endpoint := context.tenant_baseUrl + \"/v2.0/identitysources/bindings?orgId=\"+ context.org_id\n- context: bearerTokenFormatted := \"Bearer \" + context.bearerToken\n- context: idp_response := hc.GetAsJson(context.ids_endpoint, {\"Authorization\":context.bearerTokenFormatted})\n\n# Fetch Cloud Directory identity source\n- context: cloud_dir_endpoint := context.tenant_baseUrl + \"/v2.0/identitysources/property/realm/cloudIdentityRealm\"\n- context: cloud_dir_response := hc.GetAsJson(context.cloud_dir_endpoint, {\"Authorization\":context.bearerTokenFormatted})\n- debug: '\"=== DEBUG: Cloud Directory response ===\" + jsonToString(context.cloud_dir_response)'\n\n# Extract Cloud Directory instance ID\n- context: 'has_cloud_dir := has(context.cloud_dir_response.identitySources) && size(context.cloud_dir_response.identitySources) > 0'\n- context: 'cloud_dir_instance_id := context.has_cloud_dir ? context.cloud_dir_response.identitySources[0].id : \"NA\"'\n- debug: '\"=== DEBUG: Cloud Directory instance ID ===\" + context.cloud_dir_instance_id'\n\n# Count identity source bindings\n- context: 'idp_count := has(context.idp_response.bindings) ? size(context.idp_response.bindings) : 0'\n\n# Check if single IDP is Cloud Directory\n- context: 'single_idp_instance_id := (context.idp_count == 1 && has(context.idp_response.bindings)) ? context.idp_response.bindings[0].idpId : \"\"'\n- context: 'is_single_cloud_dir := context.idp_count == 1 && context.single_idp_instance_id == context.cloud_dir_instance_id'\n- debug: '\"=== DEBUG: Single IDP instance ID ===\" + context.single_idp_instance_id'\n- debug: '\"=== DEBUG: Is single Cloud Directory ===\" + string(context.is_single_cloud_dir)'\n\n# Return response - set is_single_idp only if it's single IDP and NOT Cloud Directory\n- return: >\n    (context.idp_count == 1 && !context.is_single_cloud_dir) ?\n        {\n            \"idp_list\": context.idp_response,\n            \"is_single_idp\": true\n        } :\n        {\n            \"idp_list\": context.idp_response\n        }"
