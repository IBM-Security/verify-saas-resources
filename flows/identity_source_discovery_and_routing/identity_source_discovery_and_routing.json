            },
            "input": {
                "inputData": "statements:\n- context: searchTerm := context.username\n- context: encodedFilter := \"userName%20sw%20%22\" + context.searchTerm + \"%22\"\n- context: users_endpoint := context.tenant_baseUrl + \"/v2.0/Users?filter=\" + context.encodedFilter\n- context: bearerTokenFormatted := \"Bearer \" + context.bearerToken\n- context: user_response := hc.GetAsJson(context.users_endpoint, {\"Authorization\":context.bearerTokenFormatted})\n- debug: '\"=== DEBUG: API Response ===\" + jsonToString(context.user_response)'\n\n# Extract resources array from SCIM response\n- context: 'resources := has(context.user_response.Resources) ? context.user_response.Resources : []'\n- debug: '\"=== DEBUG: Resources size ===\" + string(size(context.resources))'\n\n# Flag whether the user exists at all\n- context: 'user_found := size(context.resources) > 0'\n- debug: '\"=== DEBUG: User found ===\" + string(context.user_found)'\n\n# Grab the first (and assumed only) matched user\n- context: 'matched_user := context.user_found ? context.resources[0] : {}'\n- debug: '\"=== DEBUG: Matched user ===\" + jsonToString(context.matched_user)'\n\n# Check if the user has the IBM extension with at least one organization\n- context: 'ibm_ext_key := \"urn:ietf:params:scim:schemas:extension:ibm:2.0:User\"'\n- context: 'has_ibm_ext := context.user_found && context.ibm_ext_key in context.matched_user'\n- context: 'ibm_ext := context.has_ibm_ext ? context.matched_user[context.ibm_ext_key] : {}'\n- context: 'has_org_membership := context.has_ibm_ext && \"organizations\" in context.ibm_ext && size(context.ibm_ext.organizations) > 0'\n- debug: '\"=== DEBUG: Has IBM ext ===\" + string(context.has_ibm_ext)'\n- debug: '\"=== DEBUG: Has org membership ===\" + string(context.has_org_membership)'\n\n# Determine if this is a tenant user (exists but no org membership)\n- context: 'is_tenant_user := context.user_found && !context.has_org_membership'\n- debug: '\"=== DEBUG: Is tenant user ===\" + string(context.is_tenant_user)'\n\n# Extract org details from the first organization entry (single org assumed)\n- context: 'first_org := context.has_org_membership ? context.ibm_ext.organizations[0] : {}'\n- context: 'org_id := context.has_org_membership ? (\"value\" in context.first_org ? context.first_org.value : \"\") : \"\"'\n- context: 'org_name := context.has_org_membership ? (\"displayName\" in context.first_org ? context.first_org.displayName : \"\") : \"\"'\n- debug: '\"=== DEBUG: Org ID ===\" + context.org_id'\n- debug: '\"=== DEBUG: Org name ===\" + context.org_name'\n\n# Return: not found | tenant user | org member\n- return: >\n    !context.user_found ?\n        {\"user_found\": false} :\n    context.is_tenant_user ?\n        {\"user_found\": true, \"org_id\": \"tenant\", \"org_name\": \"Tenant\"} :\n        {\"user_found\": true, \"org_id\": context.org_id, \"org_name\": context.org_name}\n"
            },
            "output": [
                "JSON"
            ],
            "position": {
                "x": -539.2039886127332,
                "y": 519.0615773151137
            },
