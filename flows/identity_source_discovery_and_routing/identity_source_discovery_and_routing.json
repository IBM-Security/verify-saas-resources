            },
            "input": {
                "inputData": "statements:\n# Check if username is an email (contains @)\n- context: 'is_email := context.username.contains(\"@\")'\n- debug: '\"=== DEBUG: Username ===\" + context.username'\n- debug: '\"=== DEBUG: Is email ===\" + string(context.is_email)'\n\n# Extract domain from email username (will be empty string if not email)\n- context: 'email_domain := context.is_email ? context.username.split(\"@\")[1] : \"\"'\n- debug: '\"=== DEBUG: Email domain ===\" + context.email_domain'\n\n# Only make API call if username is an email\n- context: 'ids_endpoint := context.is_email ? context.tenant_baseUrl + \"/v2.0/identitysources/bindings/domains/\"+ context.email_domain : \"\"'\n- debug: '\"=== DEBUG: IDS endpoint ===\" + context.ids_endpoint'\n\n- context: bearerTokenFormatted := \"Bearer \" + context.bearerToken\n\n# Make API call only if username is email, otherwise set empty response\n- context: 'idp_response := context.is_email ? hc.GetAsJson(context.ids_endpoint, {\"Authorization\":context.bearerTokenFormatted}) : {}'\n- debug: '\"=== DEBUG: API Response ===\" + jsonToString(context.idp_response)'\n\n# Extract bindings array from response — assumes at most one identity source match\n- context: 'bindings := has(context.idp_response.bindings) ? context.idp_response.bindings : []'\n- debug: '\"=== DEBUG: Bindings count ===\" + string(size(context.bindings))'\n\n# Flag when an identity source matched the domain (at most one assumed)\n- context: 'domain_found := size(context.bindings) > 0'\n- debug: '\"=== DEBUG: Domain found ===\" + string(context.domain_found)'\n\n# Extract org details from the single binding\n- context: 'org_id := context.domain_found ? context.bindings[0].orgId : \"\"'\n- context: 'org_name := context.domain_found ? context.bindings[0].orgName : \"\"'\n- debug: '\"=== DEBUG: Org ID ===\" + context.org_id'\n- debug: '\"=== DEBUG: Org name ===\" + context.org_name'\n\n# Return domain_found flag; when found, include org details and idp_list so callers can read bindings[0]\n- return: >\n    !context.domain_found ?\n        {\"domain_found\": false} :\n        {\"domain_found\": true, \"org_id\": context.org_id, \"org_name\": context.org_name, \"idp_list\": context.idp_response}\n"
            },
            "output": [
                "JSON"
            ],
            "position": {
                "x": -307.15733892415494,
                "y": 859.0465988397541
            },
            "taskType": "Function"
        },
        {
            "id": "node-21-Function",
            "name": "Search User Using LoginIdentifier",
            "next": {
                "node": "Gateway_1ydiui8_customId",
                "connectionWayPoints": [
                    {
                        "x": -445.20398861273316,
                        "y": 595.0615773151137
