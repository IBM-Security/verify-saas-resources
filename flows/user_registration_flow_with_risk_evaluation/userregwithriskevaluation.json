            "input": {
                "inputData": "statements:\n- context: email := ctx.userFormData.userData['3']\n# Calls Socure EmailAuthScore API to evaluate email risk.\n# Falls back to 'false' (no risk assumed) if API is unavailable or credentials are not yet configured.\n- context: >\n    riskDecision := has(ctx.APIkey) && ctx.APIkey != \"SocureApiKey <your-api-key>\" ?\n        hc.Post(ctx.externalRiskProviderURL , {'Authorization': ctx.APIkey , 'Content-Type': 'application/json'}, \"{\\\"email\\\":\\\"\"+ context.email + \"\\\",\\\"modules\\\":[\\\"emailrisk\\\" , \\\"decision\\\"]}\").responseBody.decision.value\n        : \"accept\"\n- return: >\n        {\n            \"isRisk\": context.riskDecision != \"accept\" ? \"true\" : \"false\"\n        }\n"
